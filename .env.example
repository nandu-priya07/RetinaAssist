# Copy this file to .env and change the values. .env is never committed.

# Secret used to sign session cookies. If empty locally, a random key is generated in instance/secret_key.
# Required in production (RETINAASSIST_ENV=production).
RETINAASSIST_SECRET_KEY=

# Password for the demo accounts (doctor, staff). Only applied when the database is first created.
# Required in production; the local default below must never be used on a public deployment.
RETINAASSIST_DEMO_PASSWORD=RetinaDemo2026!

# Optional locally (falls back to the demo password); required in production and must differ from it.
RETINAASSIST_ADMIN_PASSWORD=

# Set to 1 to enable the Flask debugger (local development only).
FLASK_DEBUG=0
