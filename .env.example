# Copy this file to .env and change the values. .env is never committed.

# Secret used to sign session cookies. If empty, a random key is generated in instance/secret_key.
RETINAASSIST_SECRET_KEY=

# Password for the demo accounts (doctor, staff, admin). Only applied when the database is first created.
RETINAASSIST_DEMO_PASSWORD=RetinaDemo2026!

# Set to 1 to enable the Flask debugger (local development only).
FLASK_DEBUG=0
